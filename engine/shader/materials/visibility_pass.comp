#version 450

#extension GL_ARB_separate_shader_objects : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_control_flow_attributes : enable

#include "scalar_ops.glsl"
#include "common.glsl"
#include "scene.glsl"

layout(local_size_x = 64) in;

layout(binding = 0, std140) uniform UboScene    { SceneDesc   scene;         };
layout(binding = 1, std430) buffer SsboGlob     { uvec4       payload[];     };
layout(binding = 2, std430) readonly buffer Mem { uint        instanceMem[]; };
layout(binding = 3, std140) readonly buffer Bbo { Bucket      bucket[];      };

layout(binding = 4, std430) buffer IndirectBuf  { IndirectCmd cmd[];         };
layout(binding = 5, std430) readonly buffer Cbo { Cluster     clusters[];    };
layout(binding = 7)         uniform sampler2D hiZ;
#if defined(SEED_OUT)
// Occluder seed for the other eye, written by this eye's main pass: the
// visible (post-occlusion) clusters that pass the same size rule as the seed
// variant (LARGE / COMPACT_SEED), so the borrowed seed is both occlusion- and
// size-filtered instead of the whole visible set.
layout(binding = 10, std430) buffer SeedIndirect { IndirectCmd seedCmd[];     };
layout(binding = 11, std430) buffer SeedPayload  { uvec4       seedPayload[]; };
#endif

layout(push_constant, std430) uniform UboPush {
  uint      firstMeshlet;
  int       meshletCount;
  float     znear;
  float     objectFar;         // object draw distance in cm, 0 = unlimited
  float     smallObjectFar;    // draw distance of objects whose bounding radius is below smallObjectRadius
  float     smallObjectRadius; // cm
  float     minTanAngle;       // minimum bounding radius / distance of a drawn object (angular size)
  float     lodDistance;       // terrain LOD: tiles beyond it use level 1, beyond twice it level 2; 0 = full detail
  } push;

Instance pullInstance(uint i) {
  i *= 16;
  Instance ret;
  ret.mat[0][0] = uintBitsToFloat(instanceMem[i+0]);
  ret.mat[0][1] = uintBitsToFloat(instanceMem[i+1]);
  ret.mat[0][2] = uintBitsToFloat(instanceMem[i+2]);
  ret.mat[1][0] = uintBitsToFloat(instanceMem[i+3]);
  ret.mat[1][1] = uintBitsToFloat(instanceMem[i+4]);
  ret.mat[1][2] = uintBitsToFloat(instanceMem[i+5]);
  ret.mat[2][0] = uintBitsToFloat(instanceMem[i+6]);
  ret.mat[2][1] = uintBitsToFloat(instanceMem[i+7]);
  ret.mat[2][2] = uintBitsToFloat(instanceMem[i+8]);
  ret.mat[3][0] = uintBitsToFloat(instanceMem[i+9]);
  ret.mat[3][1] = uintBitsToFloat(instanceMem[i+10]);
  ret.mat[3][2] = uintBitsToFloat(instanceMem[i+11]);
  ret.fatness   = uintBitsToFloat(instanceMem[i+12]);
  ret.animPtr   = instanceMem[i+13];
  return ret;
  }

float hiZFetch(in sampler2D hiZ, in ivec2 ibbox[2]) {
  if(ibbox[0]==ibbox[1])
    return texelFetch(hiZ, ibbox[0], 0).x;

  const uint sz  = max(ibbox[1].x-ibbox[0].x, ibbox[1].y-ibbox[0].y);
  const int  mip = findMSB(sz - 1) + 1; // log2 of next pot

  ibbox[0].x = (ibbox[0].x >> mip);
  ibbox[0].y = (ibbox[0].y >> mip);

  ivec2 hiZsize = textureSize(hiZ,mip);
  float z =  texelFetchOffset(hiZ, ibbox[0], mip, ivec2(0,0)).x;
  if(ibbox[0].x+1<hiZsize.x)
    z = max(z, texelFetchOffset(hiZ, ibbox[0], mip, ivec2(1,0)).x);
  if(ibbox[0].y+1<hiZsize.y)
    z = max(z, texelFetchOffset(hiZ, ibbox[0], mip, ivec2(0,1)).x);
  if(ibbox[0].x+1<hiZsize.x && ibbox[0].y+1<hiZsize.y)
    z = max(z, texelFetchOffset(hiZ, ibbox[0], mip, ivec2(1,1)).x);

  return z;
  }

#if defined(MAIN_VIEW)
bool projectSphere(const vec4 sphere, out vec4 aabb, out float depthMin) {
  const vec3  c     = (scene.view * vec4(sphere.xyz, 1)).xyz;
  const float R     = sphere.w;
  const float znear = push.znear;

  if(c.z - R < znear) {
    depthMin = 0;
    aabb     = vec4(0,0,1,1);
    return true;
    }

  float z = c.z - R;
  depthMin  = scene.project[3][2]/z + scene.project[2][2];
  float P00 = scene.project[0][0];
  float P11 = scene.project[1][1];

  vec3  cr   = c * R;
  float czr2 = c.z * c.z - R * R;

  float vx   = sqrt(c.x * c.x + czr2);
  float minx = (vx * c.x - cr.z) / (vx * c.z + cr.x);
  float maxx = (vx * c.x + cr.z) / (vx * c.z - cr.x);

  float vy   = sqrt(c.y * c.y + czr2);
  float miny = (vy * c.y - cr.z) / (vy * c.z + cr.y);
  float maxy = (vy * c.y + cr.z) / (vy * c.z - cr.y);

  // OpenXR eyes have off-axis projections. Apply the principal-point offset
  // before sampling HiZ, and preserve min/max if a projection axis is flipped.
  vec2 lo = vec2(minx * P00, miny * P11) + scene.project[2].xy;
  vec2 hi = vec2(maxx * P00, maxy * P11) + scene.project[2].xy;
  aabb = vec4(min(lo, hi), max(lo, hi))*0.5 + vec4(0.5);
  return true;
  }

bool projectInstance(const Cluster cluster, out vec4 aabb, out float depthMin) {
  const uint  bId        = cluster.bucketId_commandId >> 16;
  const uint  instanceId = cluster.instanceId;

  const vec3  b[2]       = {bucket[bId].bbox[0].xyz, bucket[bId].bbox[1].xyz};
  Instance    obj        = pullInstance(instanceId);
  const float znear      = push.znear;

  aabb     = vec4(1, 1, -1, -1);
  depthMin = 1;
  for(uint i=0; i<8; ++i) {
    const vec3 pos = vec3(b[bitfieldExtract(i,0,1)].x,
                          b[bitfieldExtract(i,1,1)].y,
                          b[bitfieldExtract(i,2,1)].z);
    vec4 trPos = vec4(pos,1.0);
    trPos = vec4(obj.mat*trPos, 1.0);
    trPos = scene.viewProject*trPos;
    if(trPos.w<znear) {
      depthMin = 0;
      aabb     = vec4(0,0,1,1);
      return true;
      }

    vec3 bp = trPos.xyz/trPos.w;

    aabb.xy  = min(aabb.xy,  bp.xy);
    aabb.zw  = max(aabb.zw,  bp.xy);
    depthMin = min(depthMin, bp.z);
    }

  aabb = aabb*0.5 + vec4(0.5);
  return true;
  }

bool hiZTest(vec4 sbbox, float depthMin) {
  if(depthMin<=0)
    return true;

  ivec2 hiZsize = textureSize(hiZ,0);
  ivec2 ibbox[2];
  ibbox[0] = ivec2(sbbox.xy * scene.screenRes) / scene.hiZTileSize;
  ibbox[1] = ivec2(sbbox.zw * scene.screenRes) / scene.hiZTileSize;
  ibbox[0] = clamp(ibbox[0], ivec2(0), hiZsize - ivec2(1));
  ibbox[1] = clamp(ibbox[1], ivec2(0), hiZsize - ivec2(1));

  float bz      = packHiZ(depthMin);
  float z       = hiZFetch(hiZ, ibbox);
  if(bz > z)
    return false;
  return true;
  }


bool projectCluster(const Cluster cluster, out vec4 aabb, out float depthMin) {
  if(cluster.instanceId==0xFFFFFFFF)
    return projectSphere(cluster.sphere, aabb, depthMin);
  // return projectSphere(cluster.sphere, aabb, depthMin);
  return projectInstance(cluster, aabb, depthMin);
  }
#endif

bool frustrumTest(const vec4 sphere) {
  if(sphere.w<0.f)
    return false;

  for(int i=0; i<6; ++i) {
    if(dot(vec4(sphere.xyz,1.0), scene.frustrum[i]) <= -sphere.w) {
      return false;
      }
    }

  return true;
  }

void runCluster(const uint clusterId) {
  const Cluster cluster = clusters[clusterId];
  if(cluster.sphere.w<=0.f)
    return; // disabled or deleted

  if(!frustrumTest(cluster.sphere))
    return;

  // VR terrain level of detail. Landscape meshlets carry their level in the
  // top byte of meshletCount (0 full detail, 1-2 clustered, LOD_BOUNDARY the
  // tile-boundary triangles shared by every level). A tile of LodTileSize picks
  // one level from the eye distance of its centre, so levels never overlap or
  // leave holes; with lodDistance 0 only level 0 is drawn.
  const int  meshletCount = cluster.meshletCount & 0xFFFFFF;
  const uint lod          = uint(cluster.meshletCount) >> 24;
  if(cluster.instanceId==0xFFFFFFFF && lod!=LOD_BOUNDARY) {
    uint want = 0;
    if(push.lodDistance>0.0) {
      const vec2  tile = (floor(cluster.sphere.xz/LodTileSize) + 0.5) * LodTileSize;
      const float dist = length(tile - scene.camPos.xz);
      want = dist<push.lodDistance ? 0u : (dist<push.lodDistance*2.0 ? 1u : 2u);
      }
    if(lod!=want)
      return;
    }

#if defined(MAIN_VIEW)
  // Object draw distance (VR "Object distance"). The original ZenGin clipped
  // VOBs against a zone far plane by their bounds; here the bound is the
  // cluster sphere (instance bounds), small objects use the shorter distance,
  // skinned and morph meshes always the full one, landscape is never clipped.
  // The angular-size test drops objects that would cover only a few pixels
  // whatever the distance setting; both tests are eye-position based, so the
  // two eyes and head rotation agree.
  if(cluster.instanceId!=0xFFFFFFFF && push.objectFar>0.0) {
    const uint  bId  = cluster.bucketId_commandId >> 16;
    const bool  body = (bucket[bId].flags & (BK_SKIN|BK_MORPH))!=0;
    const float dist = length(cluster.sphere.xyz - scene.camPos);
    const float far  = (!body && cluster.sphere.w<push.smallObjectRadius) ? push.smallObjectFar : push.objectFar;
    if(dist - cluster.sphere.w > far)
      return;
    if(cluster.sphere.w < dist*push.minTanAngle)
      return;
    }

  vec4  aabb     = vec4(0);
  float depthMin = 1;
  if(!projectCluster(cluster, aabb, depthMin))
    return;
#endif

#if defined(LARGE)
  {
    vec2 sz = (aabb.zw - aabb.xy)*textureSize(hiZ, 0);
    // if(sz.x*sz.y<4)
    //   return;
    if(sz.x*sz.y<16 && cluster.instanceId!=0xFFFFFFFF)
      return;
#if defined(COMPACT_SEED)
    // The initial depth pass needs useful occluders, not every distant terrain
    // patch. Omitting a small seed can only weaken HiZ: more main candidates
    // may survive, but final geometry is retained. Keep invalid projections.
    const float area = sz.x*sz.y;
    if(cluster.instanceId==0xFFFFFFFF && depthMin>0 &&
       !isnan(area) && !isinf(area) && area>=0 && area<16)
      return;
#endif
  }
#endif

#if defined(HIZ)
  if(!hiZTest(aabb, depthMin))
    return;
#endif

  const uint commandId  = cluster.bucketId_commandId & 0xFFFF;
  const uint bucketId   = cluster.bucketId_commandId >> 16;
  const uint instanceId = cluster.instanceId;
  const uint meshletId  = cluster.firstMeshlet;

  uint writeOffset = cmd[commandId].writeOffset;
  writeOffset      += atomicAdd(cmd[commandId].instanceCount, meshletCount);
  for(int i=0; i<meshletCount; ++i)
    payload[writeOffset+i] = uvec4(instanceId, meshletId+i, bucketId, 0);

#if defined(SEED_OUT)
  {
    // Same size rule as the LARGE / COMPACT_SEED seed variant.
    const vec2  sz   = (aabb.zw - aabb.xy)*textureSize(hiZ, 0);
    const float area = sz.x*sz.y;
    bool seed = true;
    if(instanceId!=0xFFFFFFFF) {
      if(area<16)
        seed = false;
      }
    else if(depthMin>0 && !isnan(area) && !isinf(area) && area>=0 && area<16) {
      seed = false;
      }
    if(seed) {
      uint seedOffset = seedCmd[commandId].writeOffset;
      seedOffset     += atomicAdd(seedCmd[commandId].instanceCount, meshletCount);
      for(int i=0; i<meshletCount; ++i)
        seedPayload[seedOffset+i] = uvec4(instanceId, meshletId+i, bucketId, 0);
      }
  }
#endif
  }

void main() {
  // firstMeshlet: start of the cluster range (the VR static shadow map culls one
  // range of the cluster list per frame); 0 and the full count for every other view.
  const uint clusterId = push.firstMeshlet + gl_GlobalInvocationID.x;
  if(gl_GlobalInvocationID.x<push.meshletCount)
    runCluster(clusterId);
  }
